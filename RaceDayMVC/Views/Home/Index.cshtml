@{
    ViewData["Title"] = "Home";
}

<section class="raceday-hero">
    <div class="container py-5">
        <div class="row align-items-center g-4 py-4">
            <div class="col-lg-7">
                <span class="raceday-badge">YOUR NEXT CHALLENGE STARTS HERE</span>

                <h1 class="display-3 fw-bold text-white mt-3">
                    Every Race.<br />
                    Every Step.<br />
                    <span class="raceday-highlight">Your Story.</span>
                </h1>

                <p class="lead text-white mt-3">
                    Discover exciting running, walking and cycling events.
                    Register for your next challenge and make every kilometre count.
                </p>

                <div class="mt-4 d-flex flex-wrap gap-3">
                    <a asp-controller="Events" asp-action="Index"
                       class="btn btn-raceday btn-lg">
                        Explore Events
                    </a>

                    <a asp-controller="Account" asp-action="Register"
                       class="btn btn-outline-light btn-lg">
                        Join RaceDay
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="raceday-feature-card">
                    <div class="raceday-feature-icon">🏃</div>
                    <h3>Find Your Next Finish Line</h3>
                    <p>
                        Browse events, choose your category, track your
                        enrolments and celebrate your results.
                    </p>
                    <div class="raceday-feature-line"></div>
                    <p class="mb-0 fw-bold">Run. Walk. Cycle. Achieve.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="text-center mb-4">
        <p class="raceday-section-label">YOUR JOURNEY STARTS HERE</p>
        <h2 class="fw-bold">One Platform. Every Challenge.</h2>
        <p class="text-muted">
            Everything you need to take part in your next sporting event.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="raceday-info-card h-100">
                <div class="raceday-card-icon">🏅</div>
                <h4>Discover Events</h4>
                <p>
                    Explore upcoming events and find a challenge
                    that suits your goals.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="raceday-info-card h-100">
                <div class="raceday-card-icon">📋</div>
                <h4>Manage Enrolments</h4>
                <p>
                    Choose your category and keep track of the
                    events you have entered.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="raceday-info-card h-100">
                <div class="raceday-card-icon">🏆</div>
                <h4>Celebrate Results</h4>
                <p>
                    View your race history, finishing times and
                    positions as you progress.
                </p>
            </div>
        </div>
    </div>
</section>
