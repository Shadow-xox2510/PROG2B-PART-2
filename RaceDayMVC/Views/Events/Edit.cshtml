@model RaceDayMVC.Models.CreateEventViewModel

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Edit Event";

    var eventId = ViewBag.EventID;
}

<section class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-7">

            <div class="raceday-register-card p-4 p-md-5">

                <span class="raceday-badge">
                    ORGANISER PORTAL
                </span>

                <h1 class="mt-3 mb-2">
                    Edit Event
                </h1>

                <p class="text-muted mb-4">
                    Update your race event information.
                </p>

                @if (TempData["EventSuccess"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["EventSuccess"]
                    </div>
                }

                @if (TempData["EventError"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["EventError"]
                    </div>
                }

                <!-- EDIT EVENT FORM -->

                <form action="/Events/Edit/@eventId"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- EVENT NAME -->

                    <div class="mb-3">

                        <label asp-for="EventName"
                               class="form-label">
                            Event Name
                        </label>

                        <input asp-for="EventName"
                               class="form-control"
                               placeholder="Enter event name"
                               required />

                        <span asp-validation-for="EventName"
                              class="text-danger"></span>

                    </div>

                    <!-- DESCRIPTION -->

                    <div class="mb-3">

                        <label asp-for="Description"
                               class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="3"
                                  required></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>

                    </div>

                    <!-- CATEGORY NAME -->

                    <div class="mb-3">

                        <label asp-for="CategoryName"
                               class="form-label">
                            Category Name
                        </label>

                        <input asp-for="CategoryName"
                               class="form-control"
                               placeholder="e.g. 5 km Open Category"
                               required />

                        <span asp-validation-for="CategoryName"
                              class="text-danger"></span>

                    </div>

                    <!-- CATEGORY DESCRIPTION -->

                    <div class="mb-3">

                        <label asp-for="CategoryDescription"
                               class="form-label">
                            Category Description
                        </label>

                        <textarea asp-for="CategoryDescription"
                                  class="form-control"
                                  rows="2"></textarea>

                        <span asp-validation-for="CategoryDescription"
                              class="text-danger"></span>

                    </div>

                    <!-- EVENT DATE -->

                    <div class="mb-3">

                        <label asp-for="EventDate"
                               class="form-label">
                            Event Date
                        </label>

                        <input asp-for="EventDate"
                               type="date"
                               class="form-control"
                               required />

                        <span asp-validation-for="EventDate"
                              class="text-danger"></span>

                    </div>

                    <!-- LOCATION -->

                    <div class="mb-3">

                        <label asp-for="Location"
                               class="form-label">
                            Location
                        </label>

                        <input asp-for="Location"
                               class="form-control"
                               required />

                        <span asp-validation-for="Location"
                              class="text-danger"></span>

                    </div>

                    <!-- EVENT TYPE -->

                    <div class="mb-3">

                        <label asp-for="EventType"
                               class="form-label">
                            Event Type
                        </label>

                        <select asp-for="EventType"
                                class="form-select">

                            <option value="Run">Run</option>

                            <option value="Walk">Walk</option>

                            <option value="Cycle">Cycle</option>

                        </select>

                        <span asp-validation-for="EventType"
                              class="text-danger"></span>

                    </div>

                    <!-- DISTANCE -->

                    <div class="mb-3">

                        <label asp-for="DistanceKm"
                               class="form-label">
                            Distance (km)
                        </label>

                        <input asp-for="DistanceKm"
                               type="number"
                               step="0.1"
                               min="0.1"
                               max="1000"
                               class="form-control"
                               required />

                        <span asp-validation-for="DistanceKm"
                              class="text-danger"></span>

                    </div>

                    <!-- ENTRY FEE -->

                    <div class="mb-3">

                        <label asp-for="EntryFee"
                               class="form-label">
                            Entry Fee (R)
                        </label>

                        <input asp-for="EntryFee"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               required />

                        <span asp-validation-for="EntryFee"
                              class="text-danger"></span>

                    </div>

                    <!-- MAXIMUM PARTICIPANTS -->

                    <div class="mb-4">

                        <label asp-for="MaximumParticipants"
                               class="form-label">
                            Maximum Participants
                        </label>

                        <input asp-for="MaximumParticipants"
                               type="number"
                               min="1"
                               class="form-control"
                               required />

                        <span asp-validation-for="MaximumParticipants"
                              class="text-danger"></span>

                    </div>

                    <!-- ACTION BUTTONS -->

                    <button type="submit"
                            class="btn btn-raceday w-100">

                        Save Changes

                    </button>

                    <a href="/Events"
                       class="btn btn-outline-secondary w-100 mt-2">

                        Cancel

                    </a>

                </form>

                <hr class="my-4" />

                <!-- EVENT BANNER -->

                <h4>Event Banner</h4>

                <p class="text-muted">
                    Upload an image to display on your event card.
                </p>

                <img src="@Url.Action("Banner", "Events", new { id = eventId })"
                     alt="Event banner"
                     class="img-fluid rounded mb-3 event-banner-preview"
                     style="max-height:250px;width:100%;object-fit:cover;"
                     onerror="this.style.display='none';" />

                <!-- BANNER UPLOAD FORM -->

                <form action="/Events/UploadBanner/@eventId"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div class="mb-3">

                        <label class="form-label">
                            Choose an event banner
                        </label>

                        <input type="file"
                               name="image"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.webp"
                               required />

                    </div>

                    <button type="submit"
                            class="btn btn-raceday">

                        Upload Banner

                    </button>

                </form>

            </div>

        </div>

    </div>

</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}