@model RaceDayMVC.Models.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="raceday-register-card">

                <h1 class="text-danger mb-3">Delete Event</h1>

                <p>Are you sure you want to delete this event?</p>

                <h3>@Model.EventName</h3>

                <p>
                    <strong>Date:</strong>
                    @(Model.EventDate?.ToString("dd MMMM yyyy") ?? "Not specified")
                </p>

                <p>
                    <strong>Location:</strong>
                    @Model.Location
                </p>

                <form asp-controller="Events"
                      asp-action="DeleteConfirmed"
                      asp-route-id="@Model.EventID"
                      method="post">

                    <button type="submit"
                            class="btn btn-danger w-100">
                        Confirm Delete
                    </button>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100 mt-2">
                        Cancel
                    </a>

                </form>

            </div>
        </div>
    </div>
</section>
