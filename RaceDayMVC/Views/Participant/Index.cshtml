@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model List<RaceDayMVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Participant Dashboard";
}

<section class="container py-5">

    <span class="raceday-badge">PARTICIPANT PORTAL</span>

    <h1 class="mt-3">Your RaceDay Journey</h1>

    <p class="text-muted">
        Discover your next challenge, track your enrolments
        and celebrate every finish line.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning mt-3">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="row g-4 mt-3">

        <!-- EXPLORE EVENTS -->
        <div class="col-md-6 col-lg-4">
            <div class="raceday-feature-card h-100">

                <div class="raceday-feature-icon">🏁</div>

                <h4>Explore Events</h4>

                <p>
                    Discover upcoming races and choose
                    your next challenge.
                </p>

                <a href="@Url.Action("Index", "Events")"
                   class="btn btn-raceday">
                    Browse Events
                </a>

            </div>
        </div>

        <!-- MY ENROLMENTS -->
        <div class="col-md-6 col-lg-4">
            <div class="raceday-feature-card h-100">

                <div class="raceday-feature-icon">📋</div>

                <h4>My Enrolments</h4>

                <p>
                    Check the events you have entered
                    and their status.
                </p>

                <a href="@Url.Action("MyEvents", "Participant")"
                   class="btn btn-raceday">
                    My Enrolments
                </a>

            </div>
        </div>

        <!-- MY RESULTS -->
        <div class="col-md-6 col-lg-4">
            <div class="raceday-feature-card h-100">

                <div class="raceday-feature-icon">🏆</div>

                <h4>My Results</h4>

                <p>
                    Review your race results and
                    personal achievements.
                </p>

                <a href="@Url.Action("MyResults", "Participant")"
                   class="btn btn-raceday">
                    View Results
                </a>

            </div>
        </div>

        <!-- MY PROFILE -->
        <div class="col-md-6 col-lg-4">
            <div class="raceday-feature-card h-100">

                <div class="raceday-feature-icon">👤</div>

                <h4>My Profile</h4>

                <p>
                    View and update your personal
                    account information.
                </p>

                <a href="@Url.Action("Index", "Profile")"
                   class="btn btn-raceday">
                    My Profile
                </a>

            </div>
        </div>

    </div>

    <hr class="my-5" />

    <h2 class="mb-3">Available Race Events</h2>

    <p class="text-muted">
        Select an event below to view its details
        and register.
    </p>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info mt-3">
            No race events are currently available.
        </div>
    }
    else
    {
        <div class="row g-4 mt-3">

            @foreach (var race in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="raceday-feature-card h-100">

                        <div class="raceday-feature-icon">🏃</div>

                        <h4>@race.EventName</h4>

                        <p>@race.Description</p>

                        <p>
                            <strong>Date:</strong>
                            @(race.EventDate?.ToString("dd MMM yyyy")
                                ?? "To be confirmed")
                        </p>

                        <p>
                            <strong>Location:</strong>
                            @race.Location
                        </p>

                        <p>
                            <strong>Distance:</strong>
                            @race.DistanceKm km
                        </p>

                        <p>
                            <strong>Entry Fee:</strong>
                            @race.EntryFee.ToString(
                                "C",
                                System.Globalization.CultureInfo
                                    .GetCultureInfo("en-ZA"))
                        </p>

                        <p>
                            <strong>Status:</strong>
                            @race.Status
                        </p>

                        <a href="@Url.Action(
                                "EventDetails",
                                "Participant",
                                new { id = race.EventID })"
                           class="btn btn-raceday">
                            View Details &amp; Enrol
                        </a>

                    </div>

                </div>
            }

        </div>
    }

</section>