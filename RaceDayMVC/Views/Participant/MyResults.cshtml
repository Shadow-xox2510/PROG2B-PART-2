@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model List<RaceDayMVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "My Race Results";
}

<section class="container py-5">

    <span class="raceday-badge">RACE ACHIEVEMENTS</span>

    <h1 class="mt-3">My Race Results</h1>

    <p class="text-muted">
        Celebrate your progress and track
        your race achievements.
    </p>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning mt-3">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="d-flex flex-wrap gap-2 mt-4 mb-4">

        <a href="@Url.Action("Index", "Participant")"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

        <a href="@Url.Action("MyEvents", "Participant")"
           class="btn btn-outline-primary">
            My Enrolments
        </a>

        <a href="@Url.Action("Index", "Events")"
           class="btn btn-raceday">
            Explore Events
        </a>

    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="raceday-info-card mt-4">

            <div class="raceday-feature-icon">🏆</div>

            <h4>No results available yet.</h4>

            <p>
                Your race results will appear here once
                an organiser has recorded them.
            </p>

            <a href="@Url.Action("MyEvents", "Participant")"
               class="btn btn-raceday">
                View My Enrolments
            </a>

        </div>
    }
    else
    {
        <div class="alert alert-success mb-4">
            You have
            <strong>@Model.Count</strong>
            recorded race result(s).
        </div>

        <div class="row g-4 mt-3">

            @foreach (var result in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="raceday-feature-card h-100">

                        <div class="raceday-feature-icon">🏆</div>

                        <h4>@result.EventName</h4>

                        <hr />

                        <p>
                            <strong>Finishing Time:</strong>
                            @result.FinishTime
                        </p>

                        <p>
                            <strong>Race Position:</strong>
                            @result.Position
                        </p>

                        <p>
                            <strong>Result Status:</strong>

                            @if (string.Equals(
                                result.ResultStatus,
                                "Published",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">
                                    Published
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @result.ResultStatus
                                </span>
                            }
                        </p>

                    </div>

                </div>
            }

        </div>
    }

</section>