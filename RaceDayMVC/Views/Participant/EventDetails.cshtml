@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model RaceDayMVC.Models.ParticipantEventViewModel

@{
    ViewData["Title"] = "Event Details";
}

<section class="container py-5">

    <span class="raceday-badge">RACEDAY EVENT</span>

    <h1 class="mt-3">@Model.Event.EventName</h1>

    <p class="text-muted">
        Explore the event and choose your category
        to participate.
    </p>

    @if (TempData["EnrolmentSuccess"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["EnrolmentSuccess"]
        </div>
    }

    @if (TempData["EnrolmentError"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["EnrolmentError"]
        </div>
    }

    @if (ViewBag.CategoryError != null)
    {
        <div class="alert alert-warning mt-3">
            @ViewBag.CategoryError
        </div>
    }

    <div class="raceday-register-card mt-4 p-4">

        <h3>Event Information</h3>

        <hr />

        <p>
            <strong>Event:</strong>
            @Model.Event.EventName
        </p>

        <p>
            <strong>Description:</strong>
            @Model.Event.Description
        </p>

        <p>
            <strong>Date:</strong>
            @(Model.Event.EventDate?.ToString("dd MMMM yyyy")
                ?? "To be confirmed")
        </p>

        <p>
            <strong>Location:</strong>
            @Model.Event.Location
        </p>

        <p>
            <strong>Event Type:</strong>
            @Model.Event.EventType
        </p>

        <p>
            <strong>Distance:</strong>
            @Model.Event.DistanceKm km
        </p>

        <p>
            <strong>Entry Fee:</strong>
            @Model.Event.EntryFee.ToString(
                "C",
                System.Globalization.CultureInfo
                    .GetCultureInfo("en-ZA"))
        </p>

        <p>
            <strong>Maximum Participants:</strong>
            @Model.Event.MaximumParticipants
        </p>

        <p>
            <strong>Status:</strong>
            @Model.Event.Status
        </p>

        <hr class="my-4" />

        <h3 class="mb-3">Choose Your Category</h3>

        @if (Model.Categories == null ||
             Model.Categories.Count == 0)
        {
            <div class="alert alert-info">
                No categories are currently available
                for this event.
            </div>
        }
        else
        {
            <form action="@Url.Action("Enrol", "Participant")"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="eventId"
                       value="@Model.Event.EventID" />

                <div class="mb-3">

                    <label for="categoryId"
                           class="form-label">
                        Select Your Category
                    </label>

                    <select id="categoryId"
                            name="categoryId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select a Category --
                        </option>

                        @foreach (var category in Model.Categories)
                        {
                            <option value="@category.CategoryID">
                                @category.CategoryName
                            </option>
                        }

                    </select>

                </div>

                <button type="submit"
                        class="btn btn-raceday w-100">
                    Enrol Now
                </button>

            </form>
        }

        <a href="@Url.Action("Index", "Participant")"
           class="btn btn-outline-secondary mt-3">
            Back to Dashboard
        </a>

        <a href="@Url.Action("Index", "Events")"
           class="btn btn-outline-secondary mt-3 ms-2">
            Browse All Events
        </a>

    </div>

</section>