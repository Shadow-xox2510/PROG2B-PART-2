@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<!-- ========================================== -->
<!-- ORGANISER ACTION BUTTONS -->
<!-- ========================================== -->

<div class="container mt-4">

    <div class="d-flex flex-wrap gap-2">

        <a href="/Events/Create"
           class="btn btn-raceday">

            + Create New Event

        </a>

        <a href="/Events"
           class="btn btn-outline-secondary">

            View Events

        </a>

    </div>

</div>

<!-- ========================================== -->
<!-- ORGANISER DASHBOARD -->
<!-- ========================================== -->

<section class="container py-5">

    <span class="raceday-badge">
        ORGANISER PORTAL
    </span>

    <h1 class="mt-3">
        Organiser Dashboard
    </h1>

    <p class="text-muted">
        Welcome to your RaceDay workspace.
        Manage your events and keep every race
        running smoothly.
    </p>

    <div class="row g-4 mt-3">

        <!-- ====================================== -->
        <!-- MANAGE EVENTS -->
        <!-- ====================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="raceday-feature-card h-100">

                <div class="raceday-feature-icon">
                    🏁
                </div>

                <h4>
                    Manage Events
                </h4>

                <p>
                    Create, edit and manage your
                    race events.
                </p>

                <a href="/Events"
                   class="btn btn-raceday">

                    View Events

                </a>

            </div>

        </div>

        <!-- ====================================== -->
        <!-- ENROLMENTS -->
        <!-- ====================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="raceday-feature-card h-100">

                <div class="raceday-feature-icon">
                    👥
                </div>

                <h4>
                    Enrolments
                </h4>

                <p>
                    Select an event to review the
                    participants registered for it.
                </p>

                <a href="/Events"
                   class="btn btn-raceday">

                    Choose Event

                </a>

            </div>

        </div>

        <!-- ====================================== -->
        <!-- RACE RESULTS -->
        <!-- ====================================== -->

        <div class="col-md-6 col-lg-4">

            <div class="raceday-feature-card h-100">

                <div class="raceday-feature-icon">
                    🏆
                </div>

                <h4>
                    Race Results
                </h4>

                <p>
                    Select an event to manage
                    participant finishing times
                    and race positions.
                </p>

                <a href="/Events"
                   class="btn btn-raceday">

                    Choose Event

                </a>

            </div>

        </div>

    </div>

</section>