@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model RaceDayMVC.Models.CaptureResultViewModel

@{
    ViewData["Title"] = "Capture Result";
}

<section class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <span class="raceday-badge">
                ORGANISER PORTAL
            </span>

            <h1 class="mt-3">
                Capture Participant Result
            </h1>

            <p class="text-muted">
                Enter the participant's finishing time
                and race position.
            </p>

            <div class="raceday-register-card mt-4 p-4 p-md-5">

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">

                        @ViewBag.ErrorMessage

                    </div>
                }

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <!-- PARTICIPANT INFORMATION -->

                <h4 class="mb-3">
                    Participant Information
                </h4>

                <p>
                    <strong>Participant:</strong>
                    @Model.ParticipantName
                </p>

                <p>
                    <strong>Enrolment ID:</strong>
                    @Model.EnrolmentID
                </p>

                <p>
                    <strong>Event ID:</strong>
                    @Model.EventID
                </p>

                <hr class="my-4" />

                <!-- CAPTURE RESULT FORM -->

                <h4 class="mb-3">
                    Race Result
                </h4>

                <form action="@Url.Action("CaptureResult", "Organiser")"
                      method="post">

                    @Html.AntiForgeryToken()

                    <!-- HIDDEN VALUES -->

                    <input type="hidden"
                           asp-for="EnrolmentID" />

                    <input type="hidden"
                           asp-for="EventID" />

                    <input type="hidden"
                           asp-for="ParticipantName" />

                    <!-- FINISH TIME -->

                    <div class="mb-3">

                        <label asp-for="FinishTime"
                               class="form-label">

                            Finish Time (HH:MM:SS)

                        </label>

                        <input asp-for="FinishTime"
                               type="text"
                               class="form-control"
                               placeholder="01:25:30"
                               required />

                        <span asp-validation-for="FinishTime"
                              class="text-danger"></span>

                        <small class="text-muted">

                            Example: 01:25:30 means
                            1 hour, 25 minutes and 30 seconds.

                        </small>

                    </div>

                    <!-- FINISHING POSITION -->

                    <div class="mb-3">

                        <label asp-for="Position"
                               class="form-label">

                            Finishing Position

                        </label>

                        <input asp-for="Position"
                               type="number"
                               min="1"
                               class="form-control"
                               placeholder="1"
                               required />

                        <span asp-validation-for="Position"
                              class="text-danger"></span>

                        <small class="text-muted">

                            Enter the participant's position
                            in the race.

                        </small>

                    </div>

                    <!-- RESULT STATUS -->

                    <div class="mb-3">

                        <label asp-for="ResultStatus"
                               class="form-label">

                            Result Status

                        </label>

                        <select asp-for="ResultStatus"
                                class="form-select">

                            <option value="Published">
                                Published
                            </option>

                            <option value="Pending">
                                Pending
                            </option>

                        </select>

                        <span asp-validation-for="ResultStatus"
                              class="text-danger"></span>

                    </div>

                    <!-- BUTTONS -->

                    <div class="d-flex flex-wrap gap-2 mt-4">

                        <button type="submit"
                                class="btn btn-raceday">

                            Save Result

                        </button>

                        <a href="@Url.Action(
                                "Enrolments",
                                "Organiser",
                                new { eventId = Model.EventID })"
                           class="btn btn-outline-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}