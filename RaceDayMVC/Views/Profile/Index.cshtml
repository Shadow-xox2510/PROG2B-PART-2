@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model RaceDayMVC.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    var dashboardController =
        Model.Role == "Organiser" ? "Organiser" : "Participant";
}

<section class="container py-5">

    <span class="raceday-badge">MY ACCOUNT</span>

    <h1 class="mt-3">My Profile</h1>

    <p class="text-muted">
        View and update your personal information.
    </p>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["ProfileSuccess"]
        </div>
    }

    @if (TempData["ProfileError"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["ProfileError"]
        </div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-warning mt-3">
            @ViewBag.ErrorMessage
        </div>
    }

    <div class="raceday-register-card mt-4 p-4 p-md-5">

        <!-- PROFILE PICTURE -->

        <h4 class="mb-3">Profile Picture</h4>

        <div class="mb-3">

            <div id="profile-placeholder"
                 class="rounded-circle bg-light border mb-3"
                 style="width:150px;
                height:150px;
                display:none;
                align-items:center;
                justify-content:center;
                font-size:65px;">

                👤

            </div>

            <img src="@Url.Action(
                        "ProfilePicture",
                        "Profile",
                        new { v = DateTime.UtcNow.Ticks })"
                 alt="Profile picture"
                 class="rounded-circle mb-3"
                 style="width:150px;
            height:150px;
            object-fit:cover;
            border:3px solid #ff7625;"
                 onerror="this.style.display='none';document.getElementById('profile-placeholder').style.display='flex';" />

        </div>

        <form action="@Url.Action("UploadPicture", "Profile")"
              method="post"
              enctype="multipart/form-data"
              class="mb-4">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label for="image"
                       class="form-label">
                    Choose a Profile Picture
                </label>

                <input type="file"
                       id="image"
                       name="image"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp"
                       required />

                <small class="text-muted">
                    Supported formats: JPG, PNG and WEBP.
                    Maximum size: 5 MB.
                </small>

            </div>

            <button type="submit"
                    class="btn btn-raceday">
                Upload Picture
            </button>

        </form>

        <hr class="my-4" />

        <!-- PERSONAL INFORMATION -->

        <h4 class="mb-3">Personal Information</h4>

        <form action="@Url.Action("Index", "Profile")"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <input type="hidden" asp-for="UserID" />

            <input type="hidden" asp-for="Role" />

            <input type="hidden" asp-for="DateRegistered" />

            <!-- FIRST NAME -->

            <div class="mb-3">

                <label asp-for="FirstName"
                       class="form-label">
                    First Name
                </label>

                <input asp-for="FirstName"
                       class="form-control"
                       placeholder="Enter your first name" />

                <span asp-validation-for="FirstName"
                      class="text-danger"></span>

            </div>

            <!-- LAST NAME -->

            <div class="mb-3">

                <label asp-for="LastName"
                       class="form-label">
                    Last Name
                </label>

                <input asp-for="LastName"
                       class="form-control"
                       placeholder="Enter your last name" />

                <span asp-validation-for="LastName"
                      class="text-danger"></span>

            </div>

            <!-- EMAIL -->

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                    Email Address
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="Enter your email address" />

                <span asp-validation-for="Email"
                      class="text-danger"></span>

            </div>

            <!-- PHONE NUMBER -->

            <div class="mb-3">

                <label asp-for="PhoneNumber"
                       class="form-label">
                    Phone Number
                </label>

                <input asp-for="PhoneNumber"
                       class="form-control"
                       placeholder="Enter your phone number" />

                <span asp-validation-for="PhoneNumber"
                      class="text-danger"></span>

            </div>

            <hr class="my-4" />

            <!-- ACCOUNT INFORMATION -->

            <h4 class="mb-3">Account Information</h4>

            <div class="mb-3">

                <label class="form-label">
                    Account Role
                </label>

                <input type="text"
                       value="@Model.Role"
                       class="form-control"
                       readonly />

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Date Registered
                </label>

                <input type="text"
                       value="@(Model.DateRegistered == default
                           ? "Not available"
                           : Model.DateRegistered.ToString("dd MMM yyyy"))"
                       class="form-control"
                       readonly />

            </div>

            <!-- BUTTONS -->

            <div class="d-flex flex-wrap gap-2 mt-4">

                <button type="submit"
                        class="btn btn-raceday">
                    Save Changes
                </button>

                <a href="@Url.Action("Index", dashboardController)"
                   class="btn btn-outline-secondary">
                    Back to Dashboard
                </a>

            </div>

        </form>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}